{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "onenote": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@softeria/ms-365-mcp-server",
        "--preset",
        "onenote",
        "--read-only"
      ],
      "enabled": true,
      "environment": {
        "MS365_MCP_TENANT_ID": "consumers"
      }
    }
  }
}
